{
  "name": "bladdersense",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "local": "npm run build && npm start",
    "seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "cron": "node --env-file-if-exists=.env scripts/cron.js",
    "import-v1": "node --env-file-if-exists=.env scripts/import-v1.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.8",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5"
  }
}
