# Postgres. Neon gives a URL ending in ?sslmode=require.
DATABASE_URL=postgres://user:password@localhost:5432/bladdersense

# Public URL of the site, used in email links and report share links.
APP_URL=http://localhost:5173

# Resend (https://resend.com). Leave blank locally: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=BladderSense <hello@bladdersense.com>

PORT=3000
